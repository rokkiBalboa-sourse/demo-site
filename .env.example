# ============================================================
# SudoStudy Production Environment Variables Template
# Скопируйте этот файл в .env на сервере: cp .env.example .env
# ============================================================

# Окружение
NODE_ENV=production
PORT=3000
APP_PORT=3339

# Внешний URL приложения (используется для генерации ссылок и QR-кодов)
APP_URL=https://exam.sudostudy.dev
NEXTAUTH_URL=https://exam.sudostudy.dev

# Секретный ключ сессий и токенов (сгенерируйте: openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_min_32_chars_random_seed_prod

# Флаг безопасных cookies (по умолчанию true в production, установите false только если работаете по чистому HTTP)
COOKIE_SECURE=true

# Учетные данные суперадминистратора при первом старте или сбросе
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_NAME=Кузнецов Валерий Сергеевич

# База данных PostgreSQL (если используется отдельный контейнер)
DB_PASSWORD=changeme_secure_db_pass
